# type: ignore

Import('env', 'output_dir')

env = env.Clone()

# godot-cpp defaults debug_symbols to dev_build, so a plain target=template_debug
# links with none at all and a crash in this library resolves to nothing. Turn it
# on for every non-release target; an explicit debug_symbols=no still wins. Has to
# happen before godot-cpp's SConstruct, which is where the option is read.
from SCons.Script import ARGUMENTS
if ARGUMENTS.get("platform") == "macos":
    # Keep the supported baseline reproducible. Leaving this unset makes
    # godot-cpp inherit the build host's SDK version (26.0 on the first machine
    # used here), needlessly preventing the extension from loading on older
    # supported Macs.
    ARGUMENTS.setdefault("macos_deployment_target", "13.0")
if ARGUMENTS.get("target", "template_debug") != "template_release":
    ARGUMENTS.setdefault("debug_symbols", "yes")

# godot-cpp has no 4.6 or 4.7 branch: master carries every API from 4.3 on and
# binds the one it is told.
ARGUMENTS.setdefault("api_version", "4.7")
env = SConscript("../godot-cpp/SConstruct")

# godot-cpp hardcodes C++17 (tools/common_compiler_flags.py) with no option to
# override it, and its own sources build from this same env, so appending a
# newer -std leaves both on every command line. MSVC then warns D9025 once per
# translation unit; GCC and Clang just take the last one silently. Drop the
# flag rather than stacking on it - the per-platform Append below sets ours.
env["CXXFLAGS"] = [f for f in env["CXXFLAGS"]
                   if not str(f).startswith(("/std:c++", "-std=c++"))]

env.Append(CPPPATH=[
    "external/",
    "external/godot-cpp/",
    "external/godot-cpp/include/",
    "external/godot-cpp/gen/include/",
    "external/libretro-common/include/",
    # rcheevos splits its headers: the public API is include/, but rc_libretro.h
    # and rhash/rc_hash_internal.h live in src/ and are included by relative path
    # from within the library, so both have to be reachable.
    "external/rcheevos/include/",
    "external/rcheevos/src/",
])

is_windows = env["platform"] == "windows"
is_android = env["platform"] == "android"
is_linux = env["platform"] == "linux"
is_macos = env["platform"] == "macos"

if is_windows:
    env.Append(CPPPATH=["external/SDL3/include/"])
    env.Append(CXXFLAGS=["/std:c++latest"])
    env.Append(LIBPATH=[r"external/SDL3/lib/x64"])
    env.Append(LIBS=["user32", "gdi32", "opengl32", "SDL3", "vulkan-1",
                     "d3d11", "d3d12", "dxgi"])
    env.Append(LINKFLAGS=['/IGNORE:4099'])
    # vulkan-1.lib is the loader's import library — symbol thunks, no loader code —
    # so it is vendored rather than taken from an installed Vulkan SDK. vulkan-1.dll
    # still comes from the user's graphics driver at runtime.
    env.Append(LIBPATH=[r"external/vulkan-loader/lib/x64"])
    # libretro-common carries an MSVC shim that defines __SSE__/__SSE2__ on x64
    # (retro_environment.h), but only three files in the SDK include it. That is
    # why sinc_resampler.c already got the SSE resampler on Windows while
    # pixconv.c and s16_to_float.c did not - their include chains never reach the
    # shim, so their "#if defined(__SSE2__)" bodies compiled out, and Windows ran
    # scalar where Linux and macOS got SSE2 from the compiler's own x86-64
    # predefines. This define closes that gap; conv_rgb565_abgr8888
    # (VideoHandler's RGB565 path) is the one that matters.
    #
    # Unlike the NEON case below, ONE define is enough: these files gate at
    # compile time only, with no runtime mask to satisfy. No baseline change
    # either - SSE2 is unconditional on x86-64. The only other file in the tree
    # reading these macros is SDL3's SDL_intrin.h, whose conditions already
    # accept _MSC_VER, so nothing there moves.
    #
    # This define REQUIRES the libretro-common submodule at 6268916 (2026-05-01)
    # or later. Before that resync, conv_rgb565_abgr8888's SSE2 body stored
    # [b,g,r,a] where its own scalar tail stored [r,g,b,a] - byte-for-byte what
    # conv_rgb565_argb8888 returns - so turning SSE2 on swapped red and blue on
    # every RGB565 core at any width >= 8. Upstream fixed it in RetroArch
    # 940371933f and libretro-common 6268916. If the submodule is ever rolled
    # back past that, drop this define with it. The check is cheap: compile
    # pixconv.c twice, once with /D__SSE2__, and diff the converted output.
    #
    # Separately, do NOT reach for /arch:AVX to light up the resampler's AVX
    # kernel: it is dead twice over, because enable_avx is only set for
    # RESAMPLER_QUALITY_HIGHER/HIGHEST and AudioHandler asks for NORMAL, and
    # sinc_resampler.c's own comment says SSE1 beats AVX at these tap counts.
    env.Append(CPPDEFINES=["__SSE__", "__SSE2__"])

if is_android:
    env.Append(CXXFLAGS=["-std=c++20"])
    # libretro-common keys all its NEON paths off __ARM_NEON__, the ARMv7-era
    # spelling. Clang for aarch64 defines __ARM_NEON (no trailing underscores),
    # so every one of them silently compiles out and the Quest runs scalar C.
    #
    # BOTH defines are needed and they do different jobs:
    #   HAVE_NEON     - compiles the NEON code in sinc_resampler.c
    #   __ARM_NEON__  - makes features_cpu.c set RETRO_SIMD_NEON, which is what
    #                   the resampler's runtime dispatch actually tests. With
    #                   only HAVE_NEON the code is present but never selected:
    #                   the mask reports ASIMD, the dispatch asks for NEON, and
    #                   the branch body is empty. Measured on Quest 3, 32040 ->
    #                   44100 Hz: scalar 33.5 us/batch, HAVE_NEON alone 33.1
    #                   (i.e. unchanged), both defines 20.7 -- a 1.62x win.
    #
    # Also switches pixconv.c and s16_to_float.c to their NEON paths; both were
    # verified to compile for arm64. features_cpu.c's ARMv7-only sub-path is
    # guarded by __arm__, which aarch64 does not define, so it stays out.
    #
    # Do NOT define HAVE_ARM_NEON_ASM_OPTIMIZATIONS: that selects
    # sinc_resampler_neon.S, which is ARMv7 assembly (.arm, push {r4, lr},
    # vmov.f32 q0) and cannot assemble for arm64 at all.
    #
    # Guarded by arch: godot-cpp's android.py also accepts x86_64 and x86_32,
    # and defining __ARM_NEON__ there sends s16_to_float.c and sinc_resampler.c
    # into "#include <arm_neon.h>" on an x86 toolchain, which does not compile.
    if env["arch"] in ("arm64", "arm32"):
        env.Append(CPPDEFINES=["HAVE_NEON", "__ARM_NEON__"])
    env.Append(LIBS=["dl", "log", "EGL", "GLESv3", "vulkan"])

if is_linux:
    env.Append(CXXFLAGS=["-std=c++20"])
    env.Append(CPPPATH=["external/SDL3/include/"])
    env.Append(LIBS=["dl", "pthread"])
    # Link the Vulkan loader, SDL3 (OpenGL HW-render context), and the GL loader
    # (direct glReadPixels) by their versioned sonames: distros ship lib*.so.N
    # but the unversioned symlinks that -lvulkan / -lSDL3 / -lGL need come with the
    # -dev/-devel packages, which may not be installed.
    #
    # libvulkan/libGL are near-universal, but SDL3 is new enough that some distros
    # (e.g. Ubuntu 24.04) package it nowhere at all, and upstream ships no prebuilt
    # Linux binary. So a copy is vendored purely to satisfy the linker. It is added
    # with -L only and NOT an rpath: ld records the SONAME (libSDL3.so.0) into
    # DT_NEEDED, and at runtime the loader still picks up the host's own SDL3 from
    # the normal search path. The vendored copy is only ever a link-time stand-in --
    # it is never what the built .so actually calls into.
    #
    # These go in LIBS, not LINKFLAGS: SCons emits LINKFLAGS *before* the object
    # files, and a toolchain defaulting to --as-needed (Ubuntu's does, Fedora's
    # does not) then drops all three, since at that point nothing has referenced a
    # symbol from them yet. The result still links, but silently produces a .so
    # with 44 undefined SDL_/vk*/gl* symbols and no DT_NEEDED entries, which fails
    # at dlopen. LIBS is emitted after the objects, so as-needed keeps them.
    env.Append(LIBS=[":libvulkan.so.1", ":libSDL3.so.0", ":libGL.so.1"])
    env.Append(LIBPATH=["external/SDL3/lib/linux-x64"])

if is_macos:
    env.Append(CXXFLAGS=["-std=c++20"])
    # Godot's macOS executable already embeds MoltenVK and exports its Vulkan
    # entry points. Loading a second dylib copy into that process duplicates
    # MoltenVK's Objective-C classes, which Apple's runtime explicitly warns can
    # cause spurious casts and crashes. Bind the Vulkan calls to the host at load
    # time instead. The official dylib remains vendored for provenance and
    # standalone diagnostics, but is deliberately not a GDExtension dependency.
    env.Append(LINKFLAGS=["-Wl,-undefined,dynamic_lookup",
                          "-framework", "Metal", "-framework", "QuartzCore"])

# The same two defines the Android block sets, and for the same reason: Clang
# for aarch64 defines __ARM_NEON, never the ARMv7-era __ARM_NEON__. The gates
# are not spelled consistently upstream -
#   pixconv.c        keys off (__ARM_NEON__ || __ARM_NEON)  -> already NEON here
#   sinc_resampler.c keys off (__ARM_NEON__ || HAVE_NEON)   -> was scalar here
# so Apple Silicon and Linux arm64 got the NEON pixel converters and the SCALAR
# resampler.
#
# It failed silently, and in the mirror image of the Android case: features_cpu.c
# sets RETRO_SIMD_NEON from sysctlbyname("hw.optional.neon") with no
# __ARM_NEON__ needed, so the dispatch in resampler_sinc_new DOES enter the
# "mask & RESAMPLER_SIMD_NEON" branch and finds the body compiled out. process
# stays on resampler_sinc_process_c and nothing is logged.
#
# This has to be a build-time define rather than a runtime re-dispatch: the same
# gate picks the filter table's tap alignment (8 with NEON, 4 without), so the
# table itself is built differently.
#
# Guarded on an explicit arch. macOS defaults to arch=universal, which compiles
# both slices from one set of CPPDEFINES, so defining __ARM_NEON__ there would
# send the x86_64 slice into <arm_neon.h>. Tools/build.py always passes a
# concrete arch; a bare "scons platform=macos" still leaves its arm64 slice
# scalar.
if (is_macos or is_linux) and env["arch"] == "arm64":
    env.Append(CPPDEFINES=["HAVE_NEON", "__ARM_NEON__"])

# Vulkan headers (bundled submodule, used on both platforms)
env.Append(CPPPATH=["external/vulkan-headers/include/"])

sources = Glob("src/*.cpp")
if is_macos:
    sources.extend(Glob("src/*.mm"))
    sources.remove(File("src/VulkanContextStub.cpp"))
sources.extend(Glob("external/libretro-common/compat/*.c"))
sources.remove(File("external/libretro-common/compat/compat_ifaddrs.c"))
sources.extend(Glob("external/libretro-common/encodings/*.c"))

sources.append("external/libretro-common/audio/conversion/s16_to_float.c")
# Cores declare their own sample rate; the Meta XR Audio context runs at Godot's
# mix rate, so AudioHandler resamples on the emulation thread.
sources.append("external/libretro-common/audio/resampler/audio_resampler.c")
# audio_resampler.c hands the driver a config_userdata vtable
sources.append("external/libretro-common/file/config_file_userdata.c")
sources.append("external/libretro-common/file/config_file.c")
sources.append("external/libretro-common/lists/string_list.c")
sources.append("external/libretro-common/audio/resampler/drivers/sinc_resampler.c")
sources.append("external/libretro-common/audio/resampler/drivers/nearest_resampler.c")
sources.append("external/libretro-common/memmap/memalign.c")
sources.append("external/libretro-common/features/features_cpu.c")
sources.append("external/libretro-common/gfx/scaler/pixconv.c")
sources.append("external/libretro-common/string/stdstring.c")
sources.append("external/libretro-common/file/file_path.c")
sources.append("external/libretro-common/file/file_path_io.c")
sources.append("external/libretro-common/time/rtime.c")
sources.append("external/libretro-common/streams/file_stream.c")
sources.append("external/libretro-common/vfs/vfs_implementation.c")

# RetroAchievements. rcheevos needs no external dependency (it carries its own
# md5 and AES), and rc_export.h defaults to RC_STATIC when none of the linkage
# macros are defined, so there is nothing to declare but the sources.
#
# RC_CLIENT_SUPPORTS_HASH turns on rc_client_begin_identify_and_load_game, which
# is the whole point: it hashes the content by RetroAchievements' console-specific
# rules and resolves it to a game in one call.
#
# The whole of rhash is compiled, including hash_encrypted.c and its aes.c. It is
# tempting to define RC_HASH_NO_ENCRYPTED to save a few KB, but (a) hash_encrypted.c
# carries no outer #ifndef of its own, so the define alone does not exclude it
# (the sources have to be dropped from this list too), and (b) that path is what
# hashes .cia/.3ds content, which the azahar cabinet needs.
#
# rc_client_raintegration.c (the Windows achievement-editor DLL) and
# rc_client_external.c are each wrapped in an #ifdef we never define, so they
# compile to nothing and are harmless to glob.
sources.extend(Glob("external/rcheevos/src/*.c"))
sources.extend(Glob("external/rcheevos/src/rcheevos/*.c"))
sources.extend(Glob("external/rcheevos/src/rapi/*.c"))
sources.extend(Glob("external/rcheevos/src/rhash/*.c"))
env.Append(CPPDEFINES=["RC_CLIENT_SUPPORTS_HASH"])

lib_prefix = "lib" if is_android else ""
library = env.SharedLibrary("{}/{}libretro_godot.{}.{}.{}{}".format(output_dir, lib_prefix, env["platform"], env["target"], env["arch"], env["SHLIBSUFFIX"]), source=sources)

Default(library)
